  "memories": [
    {
      "id": "p1",
      "category": "preference",
      "text": "匿名用户偏好用简洁中文回答问题，先给结论。",
      "kind": "note"
    },
    {
      "id": "p2",
      "category": "preference",
      "text": "匿名用户喜欢解释回答的原因和证据，不喜欢空泛奉承。",
      "kind": "note"
    },
    {
      "id": "p3",
      "category": "preference",
      "text": "匿名用户偏好无糖咖啡，早餐不喝含糖饮料。",
      "kind": "note"
    },
    {
      "id": "p4",
      "category": "preference",
      "text": "匿名用户喜欢深色界面，晚上避免刺眼背景。",
      "kind": "note"
    },
    {
      "id": "p5",
      "category": "preference",
      "text": "匿名用户希望已授权的可逆工作自动完成，外部发布需要按已批准范围执行。",
      "kind": "note"
    },
    {
      "id": "f1",
      "category": "fact",
      "text": "项目HMC客户端只支持Android，Host运行Linux，Windows只编译APK。",
      "kind": "note"
    },
    {
      "id": "f2",
      "category": "fact",
      "text": "HMC源码android目录为客户端，service目录提供Linux Host接入。",
      "kind": "note"
    },
    {
      "id": "f3",
      "category": "fact",
      "text": "Android验收保留API33模拟器，构建使用Gradle，APK需要来源回执。",
      "kind": "note"
    },
    {
      "id": "f4",
      "category": "fact",
      "text": "接入验证运行node --check server.mjs和plugin.mjs，使用node --test执行服务回归。",
      "kind": "note"
    },
    {
      "id": "f5",
      "category": "fact",
      "text": "测试服务器磁盘剩余8GB，需要清理构建缓存。",
      "kind": "note"
    },
    {
      "id": "f6",
      "category": "fact",
      "text": "模型、会话、工具和任务状态由DSH Host管理，手机不拥有最终任务状态。",
      "kind": "note"
    },
    {
      "id": "f7",
      "category": "fact",
      "text": "更正记忆前先备份SQLite数据库，保留原始记忆与审计记录。",
      "kind": "note"
    },
    {
      "id": "f8",
      "category": "fact",
      "text": "手机通过HTTPS证书和token配对Linux Host，配对失败应保留原连接。",
      "kind": "note"
    },
    {
      "id": "f9",
      "category": "fact",
      "text": "发送结果未知时重试必须复用同一requestId，避免重复提交，不清除草稿。",
      "kind": "note"
    },
    {
      "id": "f10",
      "category": "fact",
      "text": "后台任务提醒需要用户显式启用，通知点击后重新核对Host状态。",
      "kind": "note"
    },
    {
      "id": "f11",
      "category": "fact",
      "text": "匿名用户每天上午九点饮用无糖咖啡。",
      "kind": "note"
    },
    {
      "id": "f12",
      "category": "fact",
      "text": "Android手机使用系统输入法发送键，普通Enter和ShiftEnter保留多行编辑。",
      "kind": "note"
    },
